{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ornn8/bside-olivia-community/blob/main/contracts/video_capability_manifest.schema.json",
  "title": "BSide Olivia video capability BOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "bundles"],
  "properties": {
    "schema_version": {"const": "olivia.video-capability-bom.v1"},
    "version": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "bundles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/bundle"}}
  },
  "$defs": {
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "requires_gpu", "dependencies", "files"],
      "properties": {
        "id": {"enum": ["ordinary_video", "music_video"]},
        "label": {"type": "string"},
        "status": {"const": "FIXED"},
        "requires_gpu": {"type": "boolean"},
        "license_review_required": {"type": "boolean"},
        "runtime_environment": {
          "type": "object",
          "propertyNames": {"enum": ["OLIVIA_FFMPEG_EXE", "OLIVIA_LATENTSYNC_ROOT", "OLIVIA_MINIMAX_COMFY_ROOT", "OLIVIA_SEED_VC_ROOT"]},
          "additionalProperties": {"type": "string", "pattern": "^[^/].*[^/.]$"}
        },
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "size_bytes", "sha256", "license", "sources"],
      "properties": {
        "id": {"type": "string"},
        "path": {"type": "string", "pattern": "^[^/].*[^/.]$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "license": {"type": "string"},
        "redistributable": {"type": "boolean"},
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "destination", "strip_components"],
          "properties": {
            "kind": {"const": "zip"},
            "destination": {"type": "string", "pattern": "^[^/].*[^/.]$"},
            "strip_components": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        },
        "sources": {"type": "object", "propertyNames": {"enum": ["domestic", "official"]}, "additionalProperties": {"type": "string", "format": "uri"}}
      }
    }
  }
}
