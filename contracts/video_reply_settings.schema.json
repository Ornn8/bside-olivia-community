{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p03.video-reply-setting.v1",
  "title": "Video reply setting capability, request, and result",
  "oneOf": [
    {"$ref": "#/$defs/available"},
    {"$ref": "#/$defs/unavailable"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/mutation"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "available": {"type": "object", "additionalProperties": false, "required": ["state", "enabled"], "properties": {"state": {"const": "available"}, "enabled": {"type": "boolean"}}},
    "unavailable": {"type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": {"state": {"const": "unavailable"}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "enabled"], "properties": {"request_id": {"$ref": "#/$defs/request_id"}, "enabled": {"type": "boolean"}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["request_id", "status", "enabled"], "properties": {"request_id": {"$ref": "#/$defs/request_id"}, "status": {"enum": ["APPLIED", "NOOP", "DUPLICATE"]}, "enabled": {"type": "boolean"}}},
    "error": {"oneOf": [{"$ref": "#/$defs/error_missing_field"}, {"$ref": "#/$defs/error_payload_invalid"}, {"$ref": "#/$defs/error_request_id_invalid"}, {"$ref": "#/$defs/error_conflict"}, {"$ref": "#/$defs/error_unavailable"}]},
    "error_missing_field": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"const": 400}, "message": {"type": "string"}, "data": {"$ref": "#/$defs/data_missing_field"}}}, "error_payload_invalid": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"const": 400}, "message": {"type": "string"}, "data": {"$ref": "#/$defs/data_payload_invalid"}}}, "error_request_id_invalid": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"const": 400}, "message": {"type": "string"}, "data": {"$ref": "#/$defs/data_request_id_invalid"}}}, "error_conflict": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"const": 409}, "message": {"type": "string"}, "data": {"$ref": "#/$defs/data_conflict"}}}, "error_unavailable": {"type": "object", "additionalProperties": false, "required": ["code", "message", "data"], "properties": {"code": {"const": 503}, "message": {"type": "string"}, "data": {"$ref": "#/$defs/data_unavailable"}}},
    "data_missing_field": {"type": "object", "additionalProperties": false, "required": ["status", "error_code", "retryable", "field"], "properties": {"status": {"const": "FAILED"}, "error_code": {"const": "MISSING_FIELD"}, "retryable": {"const": false}, "field": {"enum": ["enabled", "request_id"]}}}, "data_payload_invalid": {"type": "object", "additionalProperties": false, "required": ["status", "error_code", "retryable"], "properties": {"status": {"const": "FAILED"}, "error_code": {"const": "VIDEO_REPLY_SETTING_PAYLOAD_INVALID"}, "retryable": {"const": false}}}, "data_request_id_invalid": {"type": "object", "additionalProperties": false, "required": ["status", "error_code", "retryable"], "properties": {"status": {"const": "FAILED"}, "error_code": {"const": "VIDEO_REPLY_SETTING_REQUEST_ID_INVALID"}, "retryable": {"const": false}}}, "data_conflict": {"type": "object", "additionalProperties": false, "required": ["status", "error_code", "retryable"], "properties": {"status": {"const": "FAILED"}, "error_code": {"const": "VIDEO_REPLY_SETTING_REQUEST_CONFLICT"}, "retryable": {"const": false}}}, "data_unavailable": {"type": "object", "additionalProperties": false, "required": ["status", "error_code", "retryable"], "properties": {"status": {"const": "UNAVAILABLE"}, "error_code": {"const": "VIDEO_REPLY_SETTING_UNAVAILABLE"}, "retryable": {"const": true}}},
    "request_id": {"type": "string", "pattern": "^video_reply_setting:[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"}
  }
}
