{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://bside-olivia.local/contracts/video_runtime_root_v2.schema.json",
    "title": "Olivia portable video runtime root v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "version",
        "environment",
        "files",
        "build_inputs"
    ],
    "properties": {
        "schema_version": {
            "const": "olivia.video-runtime-root.v2"
        },
        "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "OLIVIA_BREEZE_TTS_PYTHON",
                "OLIVIA_LATENTSYNC_PYTHON",
                "OLIVIA_MINIMAX_COMFY_PYTHON",
                "OLIVIA_ROFORMER_PYTHON"
            ],
            "properties": {
                "OLIVIA_BREEZE_TTS_PYTHON": {
                    "enum": [
                        "breeze/runtime/python.exe",
                        "breeze/runtime/python/python.exe"
                    ]
                },
                "OLIVIA_LATENTSYNC_PYTHON": {
                    "enum": [
                        "latentsync/runtime/python.exe",
                        "latentsync/runtime/python/python.exe"
                    ]
                },
                "OLIVIA_MINIMAX_COMFY_PYTHON": {
                    "enum": [
                        "minimax/runtime/python.exe",
                        "minimax/runtime/python/python.exe"
                    ]
                },
                "OLIVIA_ROFORMER_PYTHON": {
                    "enum": [
                        "roformer/runtime/python.exe",
                        "roformer/runtime/python/python.exe"
                    ]
                }
            }
        },
        "files": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/file"
            }
        },
        "build_inputs": {
            "$ref": "#/$defs/buildInputs"
        }
    },
    "$defs": {
        "file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "size_bytes",
                "sha256"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\\\]*$"
                },
                "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "legal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "sha256"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\\\]*$"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "upstream",
                "revision",
                "tree_sha256",
                "dependencies",
                "license",
                "notice",
                "files"
            ],
            "properties": {
                "upstream": {
                    "type": "string",
                    "pattern": "^https?://[^\\s?#]+$"
                },
                "revision": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "tree_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "dependencies": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+==[A-Za-z0-9+_.-]+$"
                    }
                },
                "license": {
                    "$ref": "#/$defs/legal"
                },
                "notice": {
                    "$ref": "#/$defs/legal"
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/file"
                    }
                }
            }
        },
        "buildInputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "components"
            ],
            "properties": {
                "schema_version": {
                    "const": "olivia.video-runtime-build-inputs.v1"
                },
                "components": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "breeze",
                        "latentsync",
                        "minimax",
                        "roformer"
                    ],
                    "properties": {
                        "breeze": {
                            "$ref": "#/$defs/component"
                        },
                        "latentsync": {
                            "$ref": "#/$defs/component"
                        },
                        "minimax": {
                            "$ref": "#/$defs/component"
                        },
                        "roformer": {
                            "$ref": "#/$defs/component"
                        }
                    }
                }
            }
        }
    }
}
