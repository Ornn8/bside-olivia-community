{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mem0_capability_status.schema.json",
  "title": "Mem0 capability status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "capability", "state", "phase", "downloaded_bytes", "total_bytes", "remaining_bytes", "installed_bytes", "install_locations", "version", "license_summary", "requires_gpu"],
  "properties": {
    "schema_version": {"const": "olivia.capability-status.v2"},
    "status": {"enum": ["READY", "UNAVAILABLE"]},
    "capability": {"const": "long_term_memory"},
    "state": {"enum": ["missing", "queued", "downloading", "verifying", "ready", "paused", "repair", "incompatible"]},
    "phase": {"type": "string", "minLength": 1},
    "downloaded_bytes": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "remaining_bytes": {"type": "integer", "minimum": 0},
    "installed_bytes": {"type": "integer", "minimum": 0},
    "install_locations": {
      "const": [
        {"root": "installation_root", "relative_path": "runtime/mem0-site-packages"},
        {"root": "local_data_root", "relative_path": "memory/model-cache"}
      ]
    },
    "current_file": {"type": "string", "minLength": 1, "maxLength": 160},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license_summary": {"type": "string", "minLength": 1},
    "requires_gpu": {"type": "boolean"},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "ready"}}, "required": ["state"]}, "then": {"properties": {"status": {"const": "READY"}}}},
    {"if": {"properties": {"state": {"not": {"const": "ready"}}}, "required": ["state"]}, "then": {"properties": {"status": {"const": "UNAVAILABLE"}}}}
  ]
}
