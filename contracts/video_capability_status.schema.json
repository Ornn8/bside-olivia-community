{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ornn8/bside-olivia-community/blob/main/contracts/video_capability_status.schema.json",
  "title": "Video capability status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "capability", "can_uninstall", "install_locations", "bundles"],
  "properties": {
    "schema_version": {"const": "olivia.video-capability-status.v2"},
    "status": {"enum": ["READY", "UNAVAILABLE"]},
    "capability": {"const": "video"},
    "can_uninstall": {"type": "boolean"},
    "install_locations": {"type": "array", "items": {"type": "object"}},
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "downloaded_bytes", "total_bytes", "remaining_bytes"],
        "properties": {
          "id": {"enum": ["ordinary_video", "music_video"]},
          "state": {"enum": ["missing", "queued", "downloading", "verifying", "ready", "paused", "failed", "license_review_required", "prerequisites_required"]},
          "downloaded_bytes": {"type": "integer", "minimum": 0},
          "total_bytes": {"type": "integer", "minimum": 0},
          "remaining_bytes": {"type": "integer", "minimum": 0},
          "current_file": {"type": "string"},
          "source": {"type": "string"},
          "reason_code": {"type": "string"}
        }
      }
    },
    "runtime_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "checked_bytes", "total_bytes"],
      "properties": {
        "state": {"enum": ["idle", "required", "queued", "extracting", "checking", "testing", "ready", "failed"]},
        "checked_bytes": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{3,95}$"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "vendor", "minimum_vram_mib", "detected_vram_mib", "reason_code"],
      "properties": {
        "status": {"enum": ["READY", "UNAVAILABLE"]},
        "vendor": {"type": "string"},
        "minimum_vram_mib": {"const": 10240},
        "detected_vram_mib": {"type": ["integer", "null"], "minimum": 0},
        "reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{3,95}$"}
      }
    }
  }
}
