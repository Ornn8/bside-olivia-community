{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "original_client_companion_mutation_contract.schema.json",
  "title": "P03 original-client companion mutation route contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routes", "error_codes", "read_states"],
  "properties": {
    "schema_version": {"const": "p03.original-companion-mutation-contract.v1"},
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["/toy/companion/memory/clear"],
      "properties": {
        "/toy/companion/memory/clear": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methods", "confirmation", "request_fields", "success_statuses"],
          "properties": {
            "methods": {"const": ["POST", "OPTIONS"]},
            "confirmation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["header", "body"],
              "properties": {
                "header": {"const": {"name": "X-Olivia-Companion-Action", "value": "confirmed"}},
                "body": {"const": {"field": "confirmed", "value": true}}
              }
            },
            "request_fields": {"const": ["request_id", "reason", "confirmed"]},
            "success_statuses": {"const": ["APPLIED", "DUPLICATE", "NOOP"]}
          }
        }
      }
    },
    "read_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "pending"],
      "properties": {
        "statuses": {"const": ["READY", "PAUSED", "UNAVAILABLE"]},
        "pending": {
          "const": {
            "reason_code": "MEMORY_ADMIN_CLEAR_PENDING",
            "memory_state": "unavailable",
            "top_level_status": "UNAVAILABLE"
          }
        }
      }
    },
    "error_codes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["http_status", "status", "retryable"],
        "properties": {"http_status": {"enum": [400, 403, 409, 413, 415, 503]}, "status": {"enum": ["FAILED", "UNAVAILABLE"]}, "retryable": {"type": "boolean"}}
      },
      "minProperties": 1,
      "properties": {
        "MEMORY_CLEAR_CONFIRMATION_REQUIRED": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http_status", "status", "retryable"],
          "properties": {
            "http_status": {"const": 400},
            "status": {"const": "FAILED"},
            "retryable": {"const": false}
          }
        }
      }
    }
  }
}
