{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p02.persona.v2",
  "title": "Persona 2.0 declaration registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "persona_id", "declarations"],
  "properties": {
    "schema_version": {"const": "p02.persona.v2"},
    "persona_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "declarations": {
      "type": "array",
      "items": {"$ref": "#/$defs/declaration"}
    }
  },
  "$defs": {
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "source_id",
        "tier",
        "confidence",
        "rights_status",
        "allowed_public_release",
        "statement"
      ],
      "properties": {
        "declaration_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,96}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,96}$"
        },
        "tier": {
          "enum": [
            "CONSTITUTION",
            "PUBLIC_CANON",
            "COMMUNITY_SOFT_CANON",
            "INFERRED",
            "UNCERTAINTY",
            "MODE_STYLE"
          ]
        },
        "confidence": {
          "enum": ["HIGH", "MEDIUM", "LOW"]
        },
        "rights_status": {
          "enum": [
            "REDISTRIBUTABLE",
            "SUMMARY_ONLY",
            "LOCAL_PRIVATE_ONLY",
            "UNKNOWN_BLOCK_RELEASE"
          ]
        },
        "allowed_public_release": {"type": "boolean"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "mode": {
          "enum": ["text_letter", "spoken_video", "musical_video", "future_im"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rights_status": {
                "enum": ["LOCAL_PRIVATE_ONLY", "UNKNOWN_BLOCK_RELEASE"]
              }
            }
          },
          "then": {
            "properties": {
              "allowed_public_release": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {"tier": {"const": "MODE_STYLE"}}
          },
          "then": {
            "required": ["mode"]
          },
          "else": {
            "not": {
              "required": ["mode"]
            }
          }
        }
      ]
    }
  }
}
