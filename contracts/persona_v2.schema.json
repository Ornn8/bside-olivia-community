{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p02.persona.v2",
  "title": "Persona 2.0 declaration registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "persona_id",
    "declarations"
  ],
  "properties": {
    "schema_version": {
      "const": "p02.persona.v2"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    },
    "style_exemplars": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/style_exemplar"}},
    "style_exemplar_provenance": {"$ref": "#/$defs/style_exemplar_provenance"},
    "synthetic_style_exemplar_provenance": {
      "$ref": "#/$defs/synthetic_style_exemplar_provenance"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"style_exemplars": {"minItems": 1}}, "required": ["style_exemplars"]},
      "then": {
        "anyOf": [
          {"required": ["style_exemplar_provenance"]},
          {"required": ["synthetic_style_exemplar_provenance"]}
        ]
      }
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "locale",
        "summary",
        "required_facets",
        "required_modes"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "maxLength": 32
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "required_facets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "POLICY",
              "IDENTITY",
              "BACKGROUND",
              "CORE_TRAIT",
              "AUTONOMY",
              "KNOWLEDGE_BOUNDARY",
              "EXPRESSION_STYLE",
              "RELATIONSHIP_STYLE",
              "MEMORY_CONTINUITY",
              "UNCERTAINTY",
              "MODE_STYLE",
              "SAFETY"
            ]
          }
        },
        "required_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text_letter",
              "spoken_video",
              "musical_video",
              "future_im"
            ]
          }
        }
      }
    },
    "style_exemplar_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "user_folder_count", "fold_count", "fold_user_counts",
        "holdout_fold", "training_folds", "training_text_count",
        "videos_excluded", "user_folders_indivisible", "assignment_method",
        "holdout_body_read", "user_text_policy", "assistant_text_policy",
        "contiguous_7_char_overlap_count", "user_authorization_date"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
        "user_folder_count": {"type": "integer", "minimum": 1},
        "fold_count": {"type": "integer", "minimum": 2},
        "fold_user_counts": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "holdout_fold": {"type": "integer", "minimum": 0},
        "training_folds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "training_text_count": {"type": "integer", "minimum": 1},
        "videos_excluded": {"const": true},
        "user_folders_indivisible": {"const": true},
        "assignment_method": {"const": "NFC_SHA256_SORT_ROUND_ROBIN"},
        "holdout_body_read": {"const": false},
        "user_text_policy": {"const": "SYNTHETIC"},
        "assistant_text_policy": {"const": "NON_VERBATIM_ABSTRACTION"},
        "contiguous_7_char_overlap_count": {"const": 0},
        "user_authorization_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "synthetic_style_exemplar_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "derivation", "review_basis", "private_corpus_used",
        "user_text_policy", "assistant_text_policy",
        "contiguous_7_char_overlap_count", "reviewed_at"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
        "derivation": {"const": "SYNTHETIC"},
        "review_basis": {"const": "CONSTITUTION_REVIEWED"},
        "private_corpus_used": {"const": false},
        "user_text_policy": {"const": "SYNTHETIC"},
        "assistant_text_policy": {"const": "NON_VERBATIM_ABSTRACTION"},
        "contiguous_7_char_overlap_count": {"const": 0},
        "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "style_exemplar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exemplar_id", "source_id", "derivation", "rights_status",
        "allowed_public_release", "mode", "situation", "user_text",
        "assistant_text", "style_only", "factual_authority",
        "user_text_is_synthetic", "assistant_text_is_verbatim"
      ],
      "properties": {
        "exemplar_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
        "derivation": {"enum": ["SYNTHETIC", "PRIVATE_CORPUS_ABSTRACTION"]},
        "rights_status": {"enum": ["REDISTRIBUTABLE", "SUMMARY_ONLY", "LOCAL_PRIVATE_ONLY", "UNKNOWN_BLOCK_RELEASE"]},
        "allowed_public_release": {"type": "boolean"},
        "mode": {"enum": ["text_letter", "spoken_video", "musical_video", "future_im"]},
        "situation": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,96}$"},
        "user_text": {"type": "string", "minLength": 1, "maxLength": 240},
        "assistant_text": {"type": "string", "minLength": 1, "maxLength": 400},
        "style_only": {"const": true},
        "factual_authority": {"const": false},
        "user_text_is_synthetic": {"const": true},
        "assistant_text_is_verbatim": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"rights_status": {"enum": ["LOCAL_PRIVATE_ONLY", "UNKNOWN_BLOCK_RELEASE"]}}},
          "then": {"properties": {"allowed_public_release": {"const": false}}}
        }
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "source_id",
        "tier",
        "confidence",
        "rights_status",
        "allowed_public_release",
        "statement"
      ],
      "properties": {
        "declaration_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,96}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,96}$"
        },
        "tier": {
          "enum": [
            "CONSTITUTION",
            "PUBLIC_CANON",
            "COMMUNITY_SOFT_CANON",
            "INFERRED",
            "UNCERTAINTY",
            "MODE_STYLE"
          ]
        },
        "facet": {
          "enum": [
            "POLICY",
            "IDENTITY",
            "BACKGROUND",
            "CORE_TRAIT",
            "AUTONOMY",
            "KNOWLEDGE_BOUNDARY",
            "EXPRESSION_STYLE",
            "RELATIONSHIP_STYLE",
            "MEMORY_CONTINUITY",
            "UNCERTAINTY",
            "MODE_STYLE",
            "SAFETY"
          ]
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "rights_status": {
          "enum": [
            "REDISTRIBUTABLE",
            "SUMMARY_ONLY",
            "LOCAL_PRIVATE_ONLY",
            "UNKNOWN_BLOCK_RELEASE"
          ]
        },
        "allowed_public_release": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "mode": {
          "enum": [
            "text_letter",
            "spoken_video",
            "musical_video",
            "future_im"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rights_status": {
                "enum": [
                  "LOCAL_PRIVATE_ONLY",
                  "UNKNOWN_BLOCK_RELEASE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allowed_public_release": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": "MODE_STYLE"
              }
            }
          },
          "then": {
            "required": [
              "mode"
            ]
          },
          "else": {
            "not": {
              "required": [
                "mode"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "facet": {
                "const": "MODE_STYLE"
              }
            },
            "required": [
              "facet"
            ]
          },
          "then": {
            "properties": {
              "tier": {
                "const": "MODE_STYLE"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      ]
    }
  }
}
