+// Consistent read-only view for HTTP inventory and health surfaces.  Keeping
+// the registry lock across the snapshot avoids a request acquiring the same
+// mutex through several independent getters while the registry is changing.
+struct EngineSnapshot {
+    std::string device_label;
+    std::vector<std::string> capabilities;
+#if defined(NEMO_SPEECH_REGISTRY_ASR)
+    std::shared_ptr<asr::Recognizer> asr;
+#endif
+#if defined(NEMO_SPEECH_REGISTRY_DIAR)
+    std::shared_ptr<asr::Diarizer> diarization;
+#endif
+};
