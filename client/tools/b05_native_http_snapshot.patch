@@ -137,5 +137,38 @@ EngineRegistry::warmup(const WarmupOptions& options) {
 #endif
 }
-
+
+EngineSnapshot
+EngineRegistry::snapshot() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    EngineSnapshot result;
+    result.device_label = device_label_;
+#if defined(NEMO_SPEECH_REGISTRY_ASR)
+    result.asr = asr_;
+    if (asr_)
+        result.capabilities.emplace_back("asr");
+#endif
+#if defined(NEMO_SPEECH_REGISTRY_DIAR)
+    result.diarization = diar_;
+    if (diar_)
+        result.capabilities.emplace_back("diarization");
+#endif
+#if defined(NEMO_SPEECH_REGISTRY_TTS)
+    if (tts_)
+        result.capabilities.emplace_back("tts");
+#endif
+#if defined(NEMO_SPEECH_REGISTRY_NMT)
+    if (nmt_)
+        result.capabilities.emplace_back("translation");
+#endif
+#if defined(NEMO_SPEECH_REGISTRY_SPEECH)
+    if (speech_) {
+        result.capabilities.emplace_back("speech-translation");
+        if (speech_->can_synthesize())
+            result.capabilities.emplace_back("speech-to-speech");
+    }
+#endif
+    return result;
+}
+
