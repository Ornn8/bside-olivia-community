{
  "$schema": "https://example.invalid/endpoint",
  "$id": "https://example.invalid/endpoint",
  "title": "B10A local module manifest",
  "type": "object",
  "required": ["schema_version", "bundle", "provider_slots", "modules"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "b10a.modules.v1"},
    "bundle": {
      "type": "object",
      "required": ["id", "version", "batch", "status"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "batch": {"const": "B10A"},
        "status": {"const": "skeleton"},
        "policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provider_slots": {"type": "object", "additionalProperties": {"type": "object"}},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.|\\.\\.)($|/))[A-Za-z0-9._/-]+$"
    },
    "module": {
      "type": "object",
      "required": [
        "id", "version", "availability", "dependencies", "optional_dependencies",
        "capabilities", "health", "processes", "ownership"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)?$"},
        "version": {"type": "string", "minLength": 1},
        "availability": {"enum": ["available", "pending", "unavailable"]},
        "implementation_batch": {"type": "string"},
        "reason": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "optional_dependencies": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "health": {
          "type": "object",
          "required": ["kind", "required_files", "description"],
          "properties": {
            "kind": {"enum": ["project_files", "pending"]},
            "required_files": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
            "description": {"type": "string"}
          },
          "additionalProperties": true
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "host", "default_port", "health_path"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"const": "built-in-mock"},
              "host": {"const": "127.0.0.1"},
              "default_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "health_path": {"const": "/health"}
            },
            "additionalProperties": true
          }
        },
        "ownership": {
          "type": "object",
          "required": ["owned_paths", "preserved_boundaries", "processes"],
          "properties": {
            "owned_paths": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}},
            "preserved_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "processes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
